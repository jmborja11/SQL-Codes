-- Dimension Tables
CREATE TABLE financials_dim_tables.dim_company AS
SELECT 
	ROW_NUMBER () OVER (ORDER BY company_id) AS row_id,
	company_id
FROM cleaned.financials_cleaned;

CREATE TABLE financials_dim_tables.dim_flags AS
SELECT 
	company_id,
	liability_assets_flag,
	net_income_flag,
	bankrupt
FROM cleaned.financials_cleaned;

-- Fact Tables
CREATE SCHEMA TW_bankrpcy_pred_db.financials_fact_tables;

CREATE TABLE financials_fact_tables.fact_profitability AS
SELECT 
	company_id,
	roac_before_interest_and_depreciation_before_interest,
  	roaa_before_interest_and_pct_after_tax,
 	roab_before_interest_and_depreciation_after_tax,
    operating_gross_margin,
    realized_sales_gross_margin,
    operating_profit_rate,
    pre_tax_net_interest_rate,
    after_tax_net_interest_rate,
    non_industry_income_and_expenditure_to_revenue,
    continuous_interest_rate_after_tax,
    tax_rate_a,
    gross_profit_to_sales,
    net_income_to_total_assets,
    net_income_to_stockholders_equity
FROM cleaned.financials_cleaned;

CREATE TABLE financials_fact_tables.fact_growth AS
SELECT 
	company_id,
	realized_sales_gross_profit_growth_rate,
	operating_profit_growth_rate,
	after_tax_net_profit_growth_rate,
	regular_net_profit_growth_rate,
	continuous_net_profit_growth_rate,
	total_asset_growth_rate,
	net_value_growth_rate,
	total_asset_return_growth_rate_ratio,
	cash_reinvestment_pct
FROM cleaned.financials_cleaned;

CREATE TABLE financials_fact_tables.fact_liquidity AS
SELECT
	company_id,
	current_ratio,
	quick_ratio,
	cash_to_total_assets,
	quick_assets_to_total_assets,
	current_assets_to_total_assets,
	quick_assets_to_current_liability,
	cash_to_current_liability,
	current_liability_to_current_assets,
	no_credit_interval
FROM cleaned.financials_cleaned;

